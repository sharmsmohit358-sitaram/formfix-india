---
import Base from '../../layouts/Base.astro';
import ImageTool from '../../components/tools/ImageTool.tsx';
import StepStrip from '../../components/StepStrip.astro';
---
<Base title="Resize Image to 20 KB Online Free | Photo Size Reducer for Online Forms — FormFix India" description="Resize photo to 20 KB online free: shrink a photo or scan to 20,480 bytes or less as JPEG, in your browser. Preview before and after, size verified by actual bytes.">
<nav aria-label="Breadcrumb"><ol class="flex gap-2 text-sm text-slate-500"><li><a class="underline" href="/">Home</a></li><li aria-hidden="true">/</li><li aria-current="page">Resize Image to 20 KB</li></ol></nav>
<h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-4">Resize Image to 20 KB</h1>
<p class="text-slate-600 mt-2 max-w-2xl">For forms that ask for a photograph or document image no larger than 20 KB. The tool tries the highest quality first, then smaller sizes, and measures every candidate by actual bytes.</p>
<StepStrip steps={["Choose your file", "Check the real size", "Download"]} />
<div class="mt-6"><ImageTool client:idle targetKiB={20} title="Resize Image to 20 KB" /></div>
</Base>
