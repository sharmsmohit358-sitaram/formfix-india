---
import Base from '../../layouts/Base.astro';
import ImageTool from '../../components/tools/ImageTool.tsx';
import StepStrip from '../../components/StepStrip.astro';
---
<Base title="Resize Image to 100 KB Online Free | Photo 100 KB Size Reducer — FormFix India" description="Resize photo to 100 KB online free: for forms that allow up to 100 KB. Use this when 20 or 50 KB makes your photo too soft. Processed in your browser, output measured by actual bytes.">
<nav aria-label="Breadcrumb"><ol class="flex gap-2 text-sm text-slate-500"><li><a class="underline" href="/">Home</a></li><li aria-hidden="true">/</li><li aria-current="page">Resize Image to 100 KB</li></ol></nav>
<h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-4">Resize Image to 100 KB</h1>
<p class="text-slate-600 mt-2 max-w-2xl">For forms that allow up to 100 KB. Use this when 20 or 50 KB makes your photo too soft.</p>
<StepStrip steps={["Choose your file", "Check the real size", "Download"]} />
<div class="mt-6"><ImageTool client:idle targetKiB={100} title="Resize Image to 100 KB" /></div>
</Base>
