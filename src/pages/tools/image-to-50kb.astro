---
import Base from '../../layouts/Base.astro';
import ImageTool from '../../components/tools/ImageTool.tsx';
import StepStrip from '../../components/StepStrip.astro';
---
<Base title="Resize Image to 50 KB Online Free | Photo 50 KB Size Reducer — FormFix India" description="Resize photo to 50 KB online free: for forms that allow up to 50 KB. More headroom than 20 KB, so photos usually stay clearer. Processed in your browser, output measured by actual bytes.">
<nav aria-label="Breadcrumb" class="inline-flex max-w-full rounded-full bg-violet-50 border border-violet-100 px-3 py-1.5"><ol class="flex flex-wrap items-center gap-1.5 text-sm"><li><a class="no-underline font-semibold text-violet-700 hover:text-violet-900" href="/">🏠 Home</a></li><li aria-hidden="true" class="text-slate-400">›</li><li aria-current="page" class="font-medium text-slate-800">Resize Image to 50 KB</li></ol></nav>
<h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-4">Resize Image to 50 KB</h1>
<p class="text-slate-600 mt-2 max-w-2xl">For forms that allow up to 50 KB. More headroom than 20 KB, so photos usually stay clearer.</p>
<StepStrip steps={["Choose your file", "Check the real size", "Download"]} />
<div class="mt-6"><ImageTool client:idle targetKiB={50} title="Resize Image to 50 KB" /></div>
</Base>
