---
import Base from '../../layouts/Base.astro';
import Checker from '../../components/application-checker/Checker.tsx';
import StepStrip from '../../components/StepStrip.astro';
---
<Base title="Check Photo & Signature Size for Online Form | Application Document Checker — FormFix India" description="Check photo and signature size for an online form, locally in your browser. Archived SSC CHT 2026 profiles included with their conflicts and limits shown.">
<nav aria-label="Breadcrumb"><ol class="flex gap-2 text-sm text-slate-500"><li><a class="underline" href="/">Home</a></li><li aria-hidden="true">/</li><li aria-current="page">Application Checker</li></ol></nav>
<h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-4">Application Document Requirement Checker</h1>
<p class="text-slate-600 mt-2 max-w-2xl">Select a requirement, upload a file, and see PASS, FAIL, WARNING or UNKNOWN for each locally testable check, with the reasoning shown. A passing local check is not a guarantee of acceptance.</p>
<StepStrip steps={["Select a requirement", "Upload your file", "Read PASS / FAIL / WARNING"]} />
<div class="mt-6"><Checker client:idle /></div>
</Base>
