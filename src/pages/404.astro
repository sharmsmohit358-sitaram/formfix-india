---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | FormFix India" description="This page does not exist on FormFix India. Use the tools or homepage instead.">
<article class="card p-5 md:p-6 text-center mt-6">
  <p class="text-5xl" aria-hidden="true">😕</p>
  <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-3">Page not found</h1>
  <p class="mt-2 text-slate-700 leading-relaxed">That link does not exist. Try a working tool instead:</p>
  <p class="mt-5 flex flex-col sm:flex-row flex-wrap justify-center gap-2">
    <a class="btn w-full sm:w-auto" href="/">Go to homepage →</a>
    <a class="btn btn-secondary w-full sm:w-auto" href="/tools/image-to-20kb/">Image to 20 KB</a>
    <a class="btn btn-secondary w-full sm:w-auto" href="/application-checker/">Application checker</a>
  </p>
</article>
</Base>
