---
import Base from '../layouts/Base.astro';
---
<Base title="Resize Photo to 20 KB Online Free | Image, Signature & PDF Tools — FormFix India" description="Resize photo to 20 KB, 50 KB or 100 KB online free, signature to 10–20 KB, and compress PDF under 100 or 200 KB — in your browser, no upload, no sign-up." extraJsonLd={[
  { "@type": "WebApplication", "name": "FormFix India", "applicationCategory": "UtilitiesApplication", "operatingSystem": "Any", "offers": { "@type": "Offer", "price": "0", "priceCurrency": "INR" } },
  { "@type": "FAQPage", "mainEntity": [
    { "@type": "Question", "name": "Are my documents uploaded?", "acceptedAnswer": { "@type": "Answer", "text": "No. Processing uses Canvas and PDF libraries loaded in your browser. There is no upload endpoint in this site." } },
    { "@type": "Question", "name": "Does resizing guarantee acceptance?", "acceptedAnswer": { "@type": "Answer", "text": "No. It only fixes size, format and dimensions you can check locally. The application authority decides acceptance." } },
    { "@type": "Question", "name": "What does 20 KB mean here?", "acceptedAnswer": { "@type": "Answer", "text": "20 KiB = 20,480 bytes. Outputs are measured by actual bytes, not by an estimate." } }
  ] }
]}>
  <section class="hero rounded-2xl md:rounded-3xl p-3 md:p-10 text-white">
    <p class="inline-block rounded-full bg-white/20 px-2.5 py-1 text-[11px] md:text-sm font-bold">✨ Free &nbsp;•&nbsp; No sign-up &nbsp;•&nbsp; No upload &nbsp;•&nbsp; No stress</p>
    <h1 class="text-[27px] leading-[1.15] md:text-6xl md:leading-tight font-extrabold mt-2 md:mt-4 max-w-3xl">Fix your form photo in a minute ✨</h1>
    <p class="text-[15px] md:text-xl text-white/90 mt-2 md:mt-4 max-w-2xl">No upload. No sign-up. No stress. Just the exact size your form wants — right on your phone.</p>
    <div class="flex flex-wrap items-center gap-2 md:gap-3 mt-3 md:mt-6">
      <a class="btn btn-hero" href="/tools/image-to-20kb/">Fix my photo — 20 KB →</a>
      <a class="btn btn-hero" href="/tools/signature-10-to-20kb/">Fix my signature →</a>
      <a class="underline font-bold text-sm md:text-base" href="#tools">PDF or other size ↓</a>
    </div>
    <div class="mt-3 md:mt-6 rounded-lg md:rounded-2xl bg-white/10 px-3 py-2 md:p-4 max-w-2xl">
      <p class="text-xs md:text-sm"><strong>Example:</strong> 4.39&nbsp;MB photo → <strong>20,176 bytes</strong>.</p>
    </div>
  </section>

  <section id="tools" aria-labelledby="tools-h" class="mt-10">
    <h2 id="tools-h" class="text-2xl md:text-3xl font-bold tracking-tight">What do you want to fix? 🤔</h2>
    <p class="text-slate-600 mt-2">First pick your file type. Then pick the size your form asks for. That's it.</p>
    <div class="grid md:grid-cols-3 gap-4 mt-5">
      <article class="card tool-card p-5">
        <p class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-violet-500 to-fuchsia-500 text-3xl shadow-lg" aria-hidden="true">🖼️</p>
        <h3 class="font-bold text-lg mt-2">My photo</h3>
        <p class="text-sm text-slate-600 mt-1">For a photo or scan.</p>
        <p class="mt-4 flex flex-col gap-2">
          <a class="btn w-full" href="/tools/image-to-20kb/">Photo to 20 KB ★ Most used</a>
          <a class="btn btn-secondary w-full" href="/tools/image-to-50kb/">Photo to 50 KB</a>
          <a class="btn btn-secondary w-full" href="/tools/image-to-100kb/">Photo to 100 KB</a>
        </p>
      </article>
      <article class="card tool-card p-5">
        <p class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-pink-500 to-orange-400 text-3xl shadow-lg" aria-hidden="true">✍️</p>
        <h3 class="font-bold text-lg mt-2">My signature</h3>
        <p class="text-sm text-slate-600 mt-1">For a signature image.</p>
        <p class="mt-4">
          <a class="btn w-full" href="/tools/signature-10-to-20kb/">Signature to 10–20 KB ★ Most used</a>
        </p>
      </article>
      <article class="card tool-card p-5">
        <p class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-indigo-500 to-violet-500 text-3xl shadow-lg" aria-hidden="true">📄</p>
        <h3 class="font-bold text-lg mt-2">My PDF</h3>
        <p class="text-sm text-slate-600 mt-1">For a PDF document.</p>
        <p class="mt-4 flex flex-col gap-2">
          <a class="btn btn-secondary w-full" href="/tools/pdf-under-100kb/">PDF under 100 KB</a>
          <a class="btn btn-secondary w-full" href="/tools/pdf-under-200kb/">PDF under 200 KB</a>
        </p>
      </article>
    </div>
  </section>

  <section class="mt-10 card p-5" aria-labelledby="how-h">
    <h2 id="how-h" class="text-xl font-bold">How it works ✨</h2>
    <ol class="flex flex-wrap gap-2 mt-3 text-sm font-semibold"><li class="rounded-full bg-violet-50 border border-violet-200 px-3 py-1">1. Choose your file</li><li class="rounded-full bg-violet-50 border border-violet-200 px-3 py-1">2. Check the real size</li><li class="rounded-full bg-violet-50 border border-violet-200 px-3 py-1">3. Download</li></ol><p class="text-slate-700 mt-3">No upload, no sign-up.</p>
    <p class="mt-3 text-slate-700 leading-relaxed">Not sure? Read a <a class="underline font-bold" href="/guides/photo-20kb/">photo guide</a>, <a class="underline font-bold" href="/guides/signature-10-20kb/">signature guide</a> or <a class="underline font-bold" href="/guides/pdf-under-100kb/">PDF guide</a>, or <a class="underline font-bold" href="/application-checker/">check your file</a> before you submit.</p>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-bold">Questions? Tap to open ❓</h2>
    <div class="space-y-3 mt-3">
      <details class="card p-4"><summary class="font-bold cursor-pointer">Are my documents uploaded?</summary><p class="text-sm text-slate-700 mt-2">No. Processing uses Canvas and PDF libraries loaded in your browser. There is no upload endpoint in this site.</p></details>
      <details class="card p-4"><summary class="font-bold cursor-pointer">Does resizing guarantee acceptance?</summary><p class="text-sm text-slate-700 mt-2">No. It only fixes size, format and dimensions you can check locally. The application authority decides acceptance.</p></details>
      <details class="card p-4"><summary class="font-bold cursor-pointer">What does 20 KB mean here?</summary><p class="text-sm text-slate-700 mt-2">20 KiB = 20,480 bytes. Outputs are measured by actual bytes, not by an estimate.</p></details>
    </div>
  </section>

</Base>
