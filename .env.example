# Copy to .env for local builds. Never put real secrets here.
# REQUIRED before public launch: replace with the real deployed domain (no trailing slash).
PUBLIC_SITE_URL=https://formfixindia.in
# AdSense: keep false until the owner supplies a real publisher ID and is approved.
PUBLIC_ADS_ENABLED=false
PUBLIC_ADSENSE_CLIENT_ID=
# Optional Google Search Console verification token (meta tag value only, no secret).
PUBLIC_GOOGLE_SITE_VERIFICATION=
